    "select": true,
    "text": "\nWITH o AS (SELECT latitude, longitude FROM building WHERE building_id = %(place)s AND latitude IS NOT NULL),\nper_block AS (\n    SELECT t.building_id,\n           count(*)::int AS n,\n           percentile_disc(0.5) WITHIN GROUP (ORDER BY t.resale_price) AS median_price,\n           percentile_disc(0.5) WITHIN GROUP (ORDER BY t.storey_min + t.storey_max) AS storey_sum,\n           percentile_disc(0.5) WITHIN GROUP (ORDER BY t.floor_area_sqm) AS area_median\n    FROM resale_transaction t\n    \n    WHERE t.flat_type_id = %(flat_type_id)s AND t.txn_month >= %(start)s AND t.txn_month <= %(end)s\n    GROUP BY t.building_id\n),\nfits AS (\n    SELECT p.building_id, b.block, b.street, tw.name AS town, p.n, p.median_price, p.storey_sum,\n           p.area_median, b.lease_commence_year AS lease_year, 2 * 6378100 * asin(sqrt(\n    sin((radians(b.latitude::double precision) - radians(o.latitude::double precision)) / 2) ^ 2\n    + cos(radians(o.latitude::double precision)) * cos(radians(b.latitude::double precision))\n      * sin((radians(b.longitude::double precision) - radians(o.longitude::double precision)) / 2) ^ 2)) AS distance, b.latitude, b.longitude\n    FROM per_block p\n    JOIN building b ON b.building_id = p.building_id\n    JOIN town tw ON tw.town_id = b.town_id\n    CROSS JOIN o\n    WHERE p.median_price <= %(budget)s AND b.latitude IS NOT NULL AND 2 * 6378100 * asin(sqrt(\n    sin((radians(b.latitude::double precision) - radians(o.latitude::double precision)) / 2) ^ 2\n    + cos(radians(o.latitude::double precision)) * cos(radians(b.latitude::double precision))\n      * sin((radians(b.longitude::double precision) - radians(o.longitude::double precision)) / 2) ^ 2)) <= %(radius)s\n)\nSELECT c.total, r.building_id, r.block, r.street, r.town, r.n, r.median_price, r.storey_sum, r.area_median,\n       r.lease_year, r.distance, r.latitude, r.longitude\nFROM (SELECT count(*)::int AS total FROM fits) c\nLEFT JOIN LATERAL (\n    SELECT * FROM fits ORDER BY distance, building_id LIMIT %(limit)s OFFSET %(offset)s\n) r ON true\nORDER BY r.distance, r.building_id\n",
